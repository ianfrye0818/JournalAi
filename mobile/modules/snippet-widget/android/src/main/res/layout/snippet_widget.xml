<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/snippet_widget_root"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:padding="16dp"
  android:background="@drawable/snippet_widget_background">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="JournalAI" android:textColor="#38594A" android:textSize="14sp" />
  <TextView android:id="@+id/snippet_widget_count"
    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:gravity="center_vertical" android:text="@string/snippet_widget_open"
    android:textColor="#242822" android:textSize="20sp" android:textStyle="bold" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
    android:orientation="horizontal">
    <TextView android:id="@+id/snippet_widget_add"
      android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
      android:gravity="center" android:background="@drawable/snippet_widget_button"
      android:text="@string/snippet_widget_add" android:textColor="#FFFFFF" android:textSize="16sp" />
    <TextView android:id="@+id/snippet_widget_dictate"
      android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
      android:layout_marginStart="8dp"
      android:gravity="center" android:background="@drawable/snippet_widget_button"
      android:text="@string/snippet_widget_dictate"
      android:contentDescription="@string/snippet_widget_dictate_description"
      android:textColor="#FFFFFF" android:textSize="16sp" />
  </LinearLayout>
</LinearLayout>
