{
  "expo": {
    "name": "JournalAI",
    "slug": "journalai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "journalai",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F1E8",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "dev.ianfrye.journalai"
    },
    "android": {
      "package": "dev.ianfrye.journalai",
      "adaptiveIcon": {
        "backgroundColor": "#F6F1E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F1E8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#121417"
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "JournalAI uses the microphone so you can dictate snippets. Audio is never saved.",
          "speechRecognitionPermission": "JournalAI turns your speech into text so you can dictate snippets."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "eb3049dd-01dd-4e19-8c2d-639f9e0b6737"
      }
    },
    "owner": "ianfrye.dev"
  }
}
