generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum SnippetSource {
    text
    voice
    share
}

enum DayStatus {
    open
    interviewing
    drafted
    finalized
}

model User {
    id              String   @id @default(uuid())
    email           String   @unique
    passwordHash    String
    timezone        String   @default("UTC")
    dayRolloverHour Int      @default(4) // local hour a new day starts; a 1am snippet belongs to the previous day
    isActive        Boolean  @default(true)
    monthlyRecap    Boolean  @default(false) // opt-in: the recap email contains journal content
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    MonthlySummaries MonthlySummary[]
    Snippets      Snippet[]
    DailySessions DailySession[]
    Entries       Entry[]
    StyleProfile  StyleProfile?
    Questions     Question[]

    @@map("user")
}

model Snippet {
    id         String        @id @default(uuid())
    clientId   String // Generated on device, makes sync idempotent
    text       String
    source     SnippetSource @default(text)
    capturedAt DateTime // set by the device, not the server
    // Device clock of the last edit. Sync keeps the newest copy (last write wins).
    clientUpdatedAt DateTime
    updatedAt  DateTime      @updatedAt // server clock; the cursor for GET /snippets?since=
    deletedAt  DateTime?
    sessionId  String
    userId     String

    User    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    Session DailySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    @@unique([userId, clientId])
    @@index([userId, updatedAt])
    @@map("snippet")
}

model DailySession {
    id             String    @id @default(uuid())
    date           DateTime  @db.Date // local calendar date, computed on the device
    status         DayStatus @default(open)
    interviewRound Int       @default(0)
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt
    finalizedAt    DateTime?
    userId         String

    Questions Question[]
    Entry     Entry?
    Snippets  Snippet[]

    User User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, date])
    @@map("daily_session")
}

model Question {
    id         String    @id @default(uuid())
    sessionId  String
    round      Int
    order      Int
    text       String
    options    String[]  @default([]) // suggested answers the user can tap
    rationale  String?
    answer     String?
    skipped    Boolean   @default(false)
    answeredAt DateTime?
    userId     String

    Session DailySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    User    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([sessionId, round, order])
    @@map("question")
}

model Entry {
    id        String   @id @default(uuid())
    sessionId String   @unique
    title     String?
    body      String
    aiDraft   String
    tags      String[] @default([])
    mood      String? // short AI impression of the day, e.g. "tired but hopeful"
    model     String? // AI model that wrote aiDraft
    flags     Json?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    userId    String

    Session DailySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    User    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("entry")
}

model StyleProfile {
    id        String   @id @default(uuid())
    samples   String // a few of your past entries
    notes     String? // "first person, dry humor, no emojis"
    updatedAt DateTime @updatedAt
    userId    String   @unique

    User User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("style_profile")
}

// Durable delivery state; cached content keeps retry payloads identical for Resend.
model MonthlySummary {
    id String @id @default(uuid())
    userId String
    month String
    subject String?
    text String?
    html String?
    sentAt DateTime?
    lockedUntil DateTime?
    User User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, month])
    @@map("monthly_summary")
}
