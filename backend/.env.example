NODE_ENV='development'
PORT=3000
API_URL='http://localhost:3000'
FRONTEND_URL='http://localhost:5173'

# DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/journal-ai?schema=public"

# EMAIL
FROM_EMAIL='noreply@journal-ai.com'

# REDIS
REDIS_HOST='localhost'
REDIS_PORT=6379
# REDIS_PASSWORD='password' # only if your redis uses requirepass (the docker-compose one doesn't)

# AI (server side only, never ship the key to the app)
ANTHROPIC_API_KEY='sk-ant-...'
ANTHROPIC_MODEL='claude-sonnet-5-5'

# RESEND
RESEND_API_KEY='re_...'
# Opt in with the email address of your journal account. Recaps use that account timezone.
# MONTHLY_SUMMARY_EMAIL=you@example.com
